---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { System } from '../lib/systems';
import { MONO_DARK_LOGOS, TOOL_LOGOS } from '../lib/toolLogos';

interface Props {
  system: System;
  prev: System | null;
  next: System | null;
  // Astro rendered-content component, returned by `render(entry)`.
  Content: any;
}

const { system, prev, next, Content } = Astro.props;
const { name, status, year, summary, outcome, lede, stack, heroImage, heroVideo } = system.data;
const ledeParagraphs = lede ?? [summary];
const stackLogos = stack.filter((tool) => tool in TOOL_LOGOS);
---

<Base title={`${name} — Olga Neroda`} description={outcome} ogType="article">
  <SiteHeader />

  <main>
    <div class:list={['hero', { 'has-image': !!heroImage }]}>
      {heroImage && <img class="hero-bg" src={heroImage} alt="" role="presentation" />}
      {heroVideo && (
        <video
          class="hero-bg hero-bg-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster={heroImage}
          aria-hidden="true"
        >
          {heroVideo.webm && <source src={heroVideo.webm} type="video/webm" />}
          <source src={heroVideo.mp4} type="video/mp4" />
        </video>
      )}
      <div class="wrap hero-inner">
        <div class="eyebrow">
          <span>{status}</span>
          <span>{year}</span>
        </div>
        <h1>{name}</h1>
        <div class="lede">
          {ledeParagraphs.map((p) => <p>{p}</p>)}
        </div>
        {stackLogos.length > 0 && (
          <div class="stack-logos">
            {stackLogos.map((tool) => (
              <div class="stack-logo" title={tool}>
                <img
                  src={TOOL_LOGOS[tool]}
                  alt={tool}
                  loading="lazy"
                  class:list={{ 'logo-mono': MONO_DARK_LOGOS.has(tool) }}
                />
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    <Content />

    <section class="prev-next-section">
      <div class="wrap">
        <nav class="prev-next">
          {prev ? <a href={`/systems/${prev.id}/`}>← {prev.data.name}</a> : <span />}
          {next ? <a href={`/systems/${next.id}/`}>{next.data.name} →</a> : <span />}
        </nav>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .hero.has-image {
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero-bg-video {
    z-index: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-video {
      display: none;
    }
  }

  .hero.has-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.3) 45%, rgba(0, 0, 0, 0.6) 100%);
    z-index: 1;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
  }

  .hero.has-image .eyebrow {
    color: rgba(255, 255, 255, 0.72);
  }

  .hero.has-image h1 {
    color: #fff;
  }

  .hero.has-image .lede {
    color: rgba(255, 255, 255, 0.9);
  }

  .hero.has-image .stack-logo {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(2px);
  }

  .stack-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 40px;
  }

  .stack-logo {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--card);
  }

  .stack-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .prev-next-section {
    padding: 32px 0;
  }

  .prev-next {
    display: flex;
    justify-content: space-between;
    font-size: 0.9375rem;
  }

  .prev-next a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s var(--easing);
  }

  .prev-next a:hover {
    color: var(--text);
  }
</style>
