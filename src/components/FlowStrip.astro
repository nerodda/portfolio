---
// Compact flow diagram used in registry rows. Generated from `flow` +
// `feedback` frontmatter — never hand-authored, so it can't drift from
// the system it describes. Case study pages use a hand-authored
// architecture diagram instead, embedded directly in the markdown body.
interface Props {
  flow: string[];
  feedback: boolean;
  status: string;
}

const { flow, feedback, status } = Astro.props;

const statusClass = ['live', 'prototype', 'retired'].includes(status) ? `status-${status}` : 'status-unknown';

const title = `Flow: ${flow.join(' → ')}${feedback ? ', with feedback' : ''}`;

function positions(count: number, x0: number, x1: number): number[] {
  if (count === 1) return [(x0 + x1) / 2];
  return Array.from({ length: count }, (_, i) => x0 + i * ((x1 - x0) / (count - 1)));
}

const xs = positions(flow.length, 4, 136);
const nodeY = 8;
const nodeSize = 6;
const connectorY = 11;
const feedbackY = 21;
const midX = (xs[0] + xs[xs.length - 1]) / 2;
---

<svg class="flow-strip" viewBox="0 0 140 24" role="img" preserveAspectRatio="xMidYMid meet">
  <title>{title}</title>

  {xs.slice(0, -1).map((x, i) => (
    <line
      x1={x + nodeSize / 2}
      y1={connectorY}
      x2={xs[i + 1] - nodeSize / 2}
      y2={connectorY}
      class={`connector ${statusClass}`}
      stroke-width="1"
      pathLength="1"
    />
  ))}

  {feedback && (
    <path
      d={`M ${xs[xs.length - 1]} ${nodeY} Q ${midX} ${feedbackY} ${xs[0]} ${nodeY}`}
      class={`feedback-curve ${statusClass}`}
      fill="none"
      stroke-width="1"
      stroke-dasharray="2 2"
    />
  )}

  {xs.map((x) => (
    <rect x={x - nodeSize / 2} y={nodeY - nodeSize / 2} width={nodeSize} height={nodeSize} rx="1" class="node" />
  ))}
</svg>

<style>
  .flow-strip {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .node {
    fill: var(--text);
  }

  .status-live {
    stroke: var(--signal);
    fill: var(--signal);
  }

  .status-prototype {
    stroke: var(--muted);
    fill: var(--muted);
  }

  .status-retired {
    stroke: var(--line-strong);
    fill: var(--line-strong);
  }

  .status-unknown {
    stroke: var(--signal);
    fill: var(--signal);
  }

  .connector {
    stroke-dashoffset: 1;
    animation: draw-connector 200ms ease-out forwards;
    animation-delay: calc(var(--i, 0) * 60ms);
  }

  .feedback-curve {
    opacity: 0;
    animation: fade-in-curve 150ms ease-out forwards;
    animation-delay: calc(var(--i, 0) * 60ms + 200ms);
  }

  @keyframes draw-connector {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade-in-curve {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .connector {
      animation: none;
      stroke-dashoffset: 0;
    }

    .feedback-curve {
      animation: none;
      opacity: 1;
    }
  }
</style>
