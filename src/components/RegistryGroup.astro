---
import RegistryRow from './RegistryRow.astro';
import type { System } from '../lib/systems';

interface Props {
  label: string;
  systems: System[];
  startIndex: number;
  /** Card layout for groups whose rows do more than click-through (e.g. hover-to-preview). */
  cards?: boolean;
}

const { label, systems, startIndex, cards = false } = Astro.props;
---

<div class="group">
  <p class="group-label">{label} · {systems.length}</p>
  <div class:list={['rows', { cards }]}>
    {systems.map((system, i) => (
      <RegistryRow system={system} index={startIndex + i} />
    ))}
  </div>
</div>

<style>
  .group + .group {
    margin-top: 64px;
  }

  .group-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .rows {
    border-top: 1px solid var(--line);
  }

  .rows > :global(.row) {
    border-bottom: 1px solid var(--line);
  }

  .rows.cards {
    border-top: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .rows.cards > :global(.row) {
    border-bottom: none;
  }

  @media (max-width: 900px) {
    .rows.cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .rows.cards {
      grid-template-columns: 1fr;
    }
  }
</style>
