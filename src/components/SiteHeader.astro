---
---

<header class="site-header">
  <div class="wrap head">
    <div class="identity">
      <a class="mark" href="/" aria-label="Olga Neroda — home">
        <span>OLGA</span>
        <span>NERODA</span>
      </a>
      <p class="subtitle">Marketing Technologist<br />AI Systems</p>
    </div>
    <nav class="head-nav">
      <a href="https://github.com/nerodda">GitHub</a>
      <a href="https://www.linkedin.com/in/olga-neroda/">LinkedIn</a>
      <button class="toggle" id="theme-toggle" type="button" aria-live="polite">Dark mode</button>
    </nav>
  </div>
</header>

<style>
  .head {
    align-items: flex-start;
    height: auto;
    padding: 16px 0;
    flex-wrap: wrap;
    row-gap: 12px;
  }

  @media (max-width: 480px) {
    .head-nav {
      width: 100%;
      justify-content: space-between;
    }
  }

  .identity {
    display: flex;
    flex-direction: column;
  }

  .subtitle {
    margin-top: 6px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  .head-nav {
    padding-top: 2px;
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  function label(theme: string | null) {
    if (btn) btn.textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
  }

  label(root.getAttribute('data-theme'));

  btn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    label(next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
