---
const { pathname } = Astro.url;

const isActive = (href: string) =>
  href === '/' ? pathname === '/' || pathname.startsWith('/systems') : pathname.startsWith(href);
---

<header class="site-header">
  <div class="wrap top-row">
    <a class="initials" href="/" aria-label="Olga Neroda — home">
      <span class="initial">OLGA</span>
      <span class="initial">NERODA</span>
    </a>

    <button class="burger" id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-extras" aria-label="Toggle menu">
      <span class="burger-bar"></span>
      <span class="burger-bar"></span>
    </button>
  </div>

  <div class="wrap info-row">
    <div class="identity" id="mobile-extras">
      <p class="role-line">Marketing Technologist</p>
      <p class="role-line">AI Systems</p>
      <p class="role-line">Digital Growth</p>
    </div>

    <nav class="site-nav">
      <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Systems</a>
      <a href="/skills" aria-current={isActive('/skills') ? 'page' : undefined}>Skills</a>
      <a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
    </nav>

    <div class="utility">
      <a href="https://github.com/nerodda">GitHub</a>
      <a href="https://www.linkedin.com/in/olga-neroda/">LinkedIn</a>
    </div>
  </div>
</header>

<style>
  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
  }

  .initials {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(10px, 2.5vw, 28px);
    text-decoration: none;
    color: var(--text);
  }

  .initial {
    font-size: clamp(1.75rem, 6vw, 4rem);
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
  }

  .burger-bar {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--text);
    transition: transform 0.2s var(--easing), opacity 0.2s var(--easing);
  }

  .site-header.menu-open .burger-bar:nth-child(1) {
    transform: translateY(3px) rotate(45deg);
  }

  .site-header.menu-open .burger-bar:nth-child(2) {
    transform: translateY(-3px) rotate(-45deg);
  }

  .info-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: flex-start;
    padding-top: 20px;
    padding-bottom: 20px;
    border-top: 1px solid var(--line);
  }

  .identity {
    flex: 1 1 200px;
  }

  .role-line {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 140px;
  }

  .site-nav a {
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--text);
  }

  .site-nav a:hover {
    color: var(--muted);
  }

  .site-nav a[aria-current='page'] {
    font-weight: 600;
  }

  .utility {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex: 1 1 140px;
  }

  .utility a {
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--muted);
  }

  .utility a:hover {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .utility {
      align-items: flex-start;
    }

    .burger {
      display: flex;
    }

    .identity,
    .utility {
      display: none;
    }

    .site-header.menu-open .identity {
      display: block;
    }

    .site-header.menu-open .utility {
      display: flex;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const burger = document.getElementById('menu-toggle');

  burger?.addEventListener('click', () => {
    const isOpen = header?.classList.toggle('menu-open') ?? false;
    burger.setAttribute('aria-expanded', String(isOpen));
  });
</script>
