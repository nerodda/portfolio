---
---

<header class="site-header">
  <div class="wrap top-row">
    <a class="initials" href="/" aria-label="Olga Neroda — home">
      <span class="initial">OLGA</span>
      <span class="initial">NERODA</span>
    </a>
    <button class="toggle" id="theme-toggle" type="button" aria-live="polite">Dark mode</button>
  </div>

  <div class="wrap info-row">
    <div class="identity">
      <p class="role-line">Marketing Technologist</p>
      <p class="role-line">AI Systems</p>
      <p class="role-line">Digital Growth</p>
    </div>

    <nav class="site-nav">
      <a href="/">Systems</a>
      <a href="/about">About</a>
      <a href="/speaking">Speaking</a>
    </nav>

    <div class="utility">
      <a href="https://github.com/nerodda">GitHub</a>
      <a href="https://www.linkedin.com/in/olga-neroda/">LinkedIn</a>
    </div>
  </div>
</header>

<style>
  .top-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    padding-top: 16px;
  }

  .initials {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(10px, 2.5vw, 28px);
    text-decoration: none;
    color: var(--text);
  }

  .initial {
    font-size: clamp(1.75rem, 6vw, 4rem);
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .info-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: flex-start;
    padding-top: 20px;
    padding-bottom: 20px;
    border-top: 1px solid var(--line);
  }

  .identity {
    flex: 1 1 200px;
  }

  .role-line {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 140px;
  }

  .site-nav a {
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--text);
  }

  .site-nav a:hover {
    color: var(--muted);
  }

  .utility {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex: 1 1 140px;
  }

  .utility a {
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--muted);
  }

  .utility a:hover {
    color: var(--text);
  }

  .toggle {
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    color: var(--muted);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s var(--easing);
  }

  .toggle:hover {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .utility {
      align-items: flex-start;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  function label(theme: string | null) {
    if (btn) btn.textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
  }

  label(root.getAttribute('data-theme'));

  btn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    label(next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
