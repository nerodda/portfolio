---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { talks, topics } from '../lib/speaking';

const description =
  'Olga Neroda is a London-based marketing technologist available for conference and meetup talks on AI systems for revenue and marketing teams — agent architecture, MarTech, and build-vs-no-code tradeoffs. Open to CFPs, in person or remote.';

const pageURL = new URL('/speaking', Astro.site).toString();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Olga Neroda',
  url: pageURL,
  description,
  jobTitle: 'Marketing Technologist',
  address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
  knowsAbout: topics,
  sameAs: ['https://www.linkedin.com/in/olga-neroda/'],
};

const talksJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Conference and meetup talks by Olga Neroda',
  url: pageURL,
  itemListElement: talks.map((talk, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: talk.title,
      description: talk.abstract,
      genre: 'Conference talk',
      keywords: talk.draws_on.join(', '),
      author: { '@type': 'Person', name: 'Olga Neroda', url: new URL('/about', Astro.site).toString() },
    },
  })),
};
---

<Base title="Speaking — Olga Neroda" description={description} jsonLd={[personJsonLd, talksJsonLd]}>
  <SiteHeader />

  <main>
    <div class="wrap hero">
      <h1>Speaking</h1>
      <div class="lede">
        <p>
          Open to CFPs and speaking invitations on AI systems for revenue and marketing teams. Reach out on{' '}
          <a href="https://www.linkedin.com/in/olga-neroda/">LinkedIn</a>.
        </p>
      </div>
    </div>

    <section>
      <div class="wrap grid">
        <div class="sec-head"><h2>Talks</h2></div>
        <div class="body">
          <div class="talks">
            {talks.map((talk) => (
              <article class="talk">
                <h3>{talk.title}</h3>
                <p class="abstract">{talk.abstract}</p>
                <p class="draws-on">Draws on: {talk.draws_on.join(', ')}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap grid">
        <div class="sec-head"><h2>Topics</h2></div>
        <div class="body">
          <ul class="topics">
            {topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .lede a {
    border-bottom: 1px solid var(--line-strong);
    text-decoration: none;
  }

  .lede a:hover {
    border-color: var(--text);
  }

  .talks {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .talk {
    padding: 28px 24px;
    background: var(--bg);
  }

  .talk h3 {
    margin-bottom: 12px;
  }

  .abstract {
    font-size: 1.0625rem;
    line-height: 1.6;
    margin-bottom: 10px;
  }

  .draws-on {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .topics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .topics li {
    border: 1px solid var(--line-strong);
    padding: 6px 12px;
    border-radius: 2px;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
