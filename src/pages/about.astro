---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const credentials = [
  'Claude Code in Action — Anthropic, 2026',
  'Advanced Google Analytics — Google, 2021',
  'ABM Certification — Demandbase, 2020',
  'Make Advanced — Make, 2025',
  'LinkedIn Marketing Strategy — LinkedIn, 2025–2027',
];
const achievements = ["Indeed Flex Marketing Employee of the Year, 2025"];
---

<Base
  title="About — Olga Neroda"
  description="About Olga Neroda, a marketing technologist who builds AI systems for revenue and marketing teams."
>
  <SiteHeader />

  <main>
    <div class="wrap hero">
      <h1>About</h1>
    </div>

    <section>
      <div class="wrap grid">
        <div class="sec-head">
          <h2>Bio</h2>
        </div>
        <div class="body">
          <div class="bio-text">
            <p>I build AI systems that make marketing and sales actually work together — not slide decks about AI, systems a team runs on every day. My approach is the same wherever I land: find the workflow that's slow, manual, or scattered across five tools, then design and ship something that fixes it end to end, the model, the guardrails, and the handoff to the people who use it.</p>
            <p>I'm a marketing technologist in London, currently Senior Manager of Digital Growth &amp; MarTech at Indeed Flex, where I build the AI systems on this site. I scoped and shipped the CV AI Builder, an LLM-powered resume tool, solo before handing it to a development partner to rebuild for production. I designed a Slack-based buying-committee agent that over 30 sellers now research from directly, scored and pushed straight into Salesforce. And I built the pipeline that drafts and sends a client report deck every Monday with no manual step in the happy path.</p>          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap grid">
        <div class="sec-head">
          <h2>Credentials &amp; achievements</h2>
        </div>
        <div class="body">
          <dl class="facts">
            <div>
              <dt>Achievements</dt>
              <dd>{achievements.join(', ')}</dd>
            </div>
            <div>
              <dt>Credentials</dt>
              <dd>{credentials.join(', ')}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .bio-text p {
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .bio-text p + p {
    margin-top: 1.15em;
  }
</style>
