---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { breadcrumbNode, personNode } from '../lib/seo';

const credentials = [
  'Claude Code in Action — Anthropic, 2026',
  'Advanced Google Analytics — Google, 2021',
  'ABM Certification — Demandbase, 2020',
  'Make Advanced — Make, 2025',
  'LinkedIn Marketing Strategy — LinkedIn, 2025–2027',
];
const achievements = ["Indeed Flex Marketing Employee of the Year, 2025"];
const education = ["AI and Data Analytics Apprenticeship — Cambridge Spark, 2024–2026"];

const description =
  'Olga Neroda is a London marketing technologist building AI systems for marketing and sales teams, and Senior Manager of Digital Growth & MarTech at Indeed Flex.';

const personJsonLd = personNode({
  description,
  jobTitle: 'Senior Manager, Digital Growth & MarTech',
  alumniOf: { '@type': 'EducationalOrganization', name: 'Cambridge Spark' },
  award: achievements,
  knowsAbout: [
    'AI systems for marketing and sales',
    'AI product management',
    'Model Context Protocol',
    'AI knowledge bases',
    'Retrieval and citation',
    'AI agent guardrails',
    'AI governance',
    'Product discovery and roadmapping',
    'Full-funnel growth strategy',
    'Demand generation',
    'Marketing automation',
    'Account-based marketing',
    'Sales enablement',
    'Marketing leadership',
    'HubSpot',
    'Salesforce',
    'Claude',
    'LinkedIn Ads',
  ],
  hasCredential: credentials.map((name) => ({
    '@type': 'EducationalOccupationalCredential',
    name,
  })),
});

// ProfilePage tells Google this page *is* the Person, which is what promotes an
// entity into the knowledge panel rather than leaving it as a loose mention.
const profilePageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL('/about/', Astro.site).toString(),
  name: 'About Olga Neroda',
  description,
  mainEntity: personJsonLd,
};

const breadcrumbJsonLd = breadcrumbNode([{ name: 'About', path: '/about/' }]);
---

<Base
  title="About Olga Neroda — Marketing Technologist, London"
  description={description}
  ogType="profile"
  imageAlt="Olga Neroda, London-based marketing technologist"
  jsonLd={[profilePageJsonLd, breadcrumbJsonLd]}
>
  <SiteHeader />

  <main>
    <div class="wrap hero about-hero">
      <h1>About</h1>
      <img
        class="portrait"
        src="/images/portrait.jpg"
        alt="Olga Neroda"
        width="800"
        height="800"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <section>
      <div class="wrap grid">
        <div class="sec-head">
          <h2>Bio</h2>
        </div>
        <div class="body">
          <div class="bio-text">
            <p>I'm a marketing technologist based in London. What I actually enjoy is forming a hypothesis about how marketing and revenue should work, then finding a way to prove it, often by building the AI system that can deliver on it. I tend to own the whole arc: the business case, the brief, the prompts and the guardrails, and the handover to the people who use it every day.</p>
            <p>I work across the full funnel, from traffic acquisition, organic and paid, through conversion, sales enablement, and onboarding. I have led marketing teams and shipped products alongside engineers, designers, and external development partners, and I care as much about whether a team adopts something as whether it works.</p>
            <p>Away from work, I read crime novels and surf.</p>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap grid">
        <div class="sec-head">
          <h2>Credentials &amp; achievements</h2>
        </div>
        <div class="body">
          <dl class="facts">
            <div>
              <dt>Achievements</dt>
              <dd>{achievements.join(', ')}</dd>
            </div>
            <div>
              <dt>Education</dt>
              <dd>{education.join(', ')}</dd>
            </div>
            <div>
              <dt>Credentials</dt>
              <dd>{credentials.join(', ')}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap grid">
        <div class="sec-head">
          <h2>Away from work</h2>
        </div>
        <div class="body">
          <div class="photos">
            <figure>
              <img src="/images/surf-beach.jpg" alt="Carrying a longboard up the beach, cliffs behind" width="1144" height="1252" loading="lazy" decoding="async" />
            </figure>
            <figure>
              <img src="/images/diving.jpg" alt="Scuba diving over a reef" width="1280" height="1050" loading="lazy" decoding="async" />
            </figure>
            <figure>
              <img class="crop-top" src="/images/surf-school.jpg" alt="Coming out of the surf carrying a board" width="1032" height="1280" loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .about-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 48px;
  }

  /* Intrinsic width/height above keep the hero from reflowing as it loads; the
     source is 800px square, so the displayed size is capped short of that to
     stay sharp on a 2x screen. */
  .portrait {
    width: clamp(200px, 26vw, 340px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Wrapping each shot in <figure> opts this column out of the 44em measure
     via the existing `.body:has(figure)` rule, so the strip runs full width. */
  .photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  /* One ratio across three different source crops — two portrait, one
     landscape — so the row reads as a set rather than a ragged edge. */
  .photos img {
    width: 100%;
    /* height:auto is load-bearing — the width/height attributes are a
       presentational hint that would otherwise pin the height and leave
       aspect-ratio with nothing to compute. */
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 2px;
  }

  /* This frame is the tallest of the three, so a centred square crop takes the
     top of the head off. Anchor it to the top instead. */
  .photos img.crop-top {
    object-position: center top;
  }

  @media (max-width: 640px) {
    .photos {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  .bio-text p {
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .bio-text p + p {
    margin-top: 1.15em;
  }
</style>
