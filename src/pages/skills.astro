---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { skillGroups, skillCount, GITHUB_REPO_URL } from '../lib/skills';

const description =
  `A browsable, searchable library of ${skillCount} AI skills across ${skillGroups.length} categories — LinkedIn, YouTube, SEO, and outbound — for running content and lead-gen ops.`;

const pageURL = new URL('/skills', Astro.site).toString();
const authorURL = new URL('/about', Astro.site).toString();

const skillsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Skills library',
  url: pageURL,
  description,
  ...(GITHUB_REPO_URL ? { sameAs: GITHUB_REPO_URL } : {}),
  author: { '@type': 'Person', name: 'Olga Neroda', url: authorURL },
  hasDefinedTerm: skillGroups.flatMap((group) =>
    group.skills.map((skill) => ({
      '@type': 'DefinedTerm',
      name: skill.name,
      description: skill.description,
      inDefinedTermSet: pageURL,
      termCode: group.category,
    }))
  ),
};

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Olga Neroda',
  url: pageURL,
  jobTitle: 'Marketing Technologist',
  knowsAbout: skillGroups.map((g) => g.category),
  sameAs: [
    'https://www.linkedin.com/in/olga-neroda/',
    'https://github.com/nerodda',
    ...(GITHUB_REPO_URL ? [GITHUB_REPO_URL] : []),
  ],
};

const jsonLd = GITHUB_REPO_URL
  ? [
      skillsJsonLd,
      personJsonLd,
      {
        '@context': 'https://schema.org',
        '@type': 'SoftwareSourceCode',
        name: 'Skills library',
        description,
        codeRepository: GITHUB_REPO_URL,
        author: { '@type': 'Person', name: 'Olga Neroda', url: authorURL },
      },
    ]
  : [skillsJsonLd, personJsonLd];
---

<Base title="Skills — Olga Neroda" description={description} jsonLd={jsonLd}>
  <SiteHeader />

  <main>
    <div class="wrap hero">
      <h1>Skills</h1>
      <div class="lede">
        <p>
          Every skill here does one job — draft a hook, audit an SEO page, script a video — and nothing else. Composed
          together, they run the day-to-day content and outbound motion.
        </p>
      </div>

      <div class="hero-actions">
        {GITHUB_REPO_URL ? (
          <a class="repo-link" href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">
            <svg class="gh-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            <span>View on GitHub</span>
          </a>
        ) : (
          <span class="repo-link pending" aria-disabled="true">
            <svg class="gh-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            <span>Repo — coming soon</span>
          </span>
        )}
      </div>
    </div>

    <section class="library-section" aria-labelledby="library-heading">
      <div class="wrap">
        <h2 id="library-heading" class="visually-hidden">Skill library</h2>

        <div class="filter-bar">
          <div class="pills" role="group" aria-label="Filter by category">
            <button type="button" class="pill" data-category="all" aria-pressed="true">All</button>
            {skillGroups.map((group) => (
              <button type="button" class="pill" data-category={group.category} aria-pressed="false">
                {group.category}
              </button>
            ))}
          </div>

          <div class="search-wrap">
            <input
              type="search"
              id="skill-search"
              class="search-input"
              placeholder="Search skills…"
              aria-label="Search skills"
              autocomplete="off"
            />
            <span class="skill-count" id="skill-count" aria-live="polite">{skillCount} of {skillCount}</span>
          </div>
        </div>

        <div id="skill-groups">
          {skillGroups.map((group) => (
            <div class="skill-group" data-category={group.category}>
              <h3 class="group-label">{group.category} · <span class="group-count">{group.skills.length}</span></h3>
              <div class="skill-grid">
                {group.skills.map((skill) =>
                  skill.url ? (
                    <a
                      class="skill-card is-linked"
                      href={skill.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-search={`${skill.name} ${skill.description}`.toLowerCase()}
                    >
                      <h4 class="skill-name">/{skill.name}</h4>
                      <p class="skill-desc">{skill.description}</p>
                    </a>
                  ) : (
                    <div class="skill-card" data-search={`${skill.name} ${skill.description}`.toLowerCase()}>
                      <h4 class="skill-name">/{skill.name}</h4>
                      <p class="skill-desc">{skill.description}</p>
                    </div>
                  )
                )}
              </div>
            </div>
          ))}
        </div>

        <p class="no-results" id="no-results" hidden>No skills match “<span id="no-results-query"></span>”.</p>
      </div>
    </section>

    <section class="stats-section">
      <div class="wrap">
        <div class="metrics">
          <div class="metric">
            <span class="fig">{skillCount}</span>
            <span class="cap">single-purpose skills, each versioned and invoked on its own</span>
          </div>
          <div class="metric">
            <span class="fig">{skillGroups.length}</span>
            <span class="cap">categories, from early-stage ideation through publish and results</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .hero-actions {
    margin-top: 40px;
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 10px 20px 10px 16px;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--text);
    transition:
      border-color 0.2s var(--easing),
      background-color 0.2s var(--easing);
  }

  a.repo-link:hover,
  a.repo-link:focus-visible {
    border-color: var(--text);
    background: var(--card);
  }

  .repo-link.pending {
    color: var(--muted);
    border-style: dashed;
    cursor: default;
  }

  .gh-icon {
    flex-shrink: 0;
  }

  .stats-section {
    border-bottom: none;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    -webkit-appearance: none;
    appearance: none;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    padding: 7px 15px;
    cursor: pointer;
    transition:
      background-color 0.2s var(--easing),
      color 0.2s var(--easing),
      border-color 0.2s var(--easing);
  }

  .pill:hover {
    border-color: var(--text);
    color: var(--text);
  }

  .pill[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .search-input {
    -webkit-appearance: none;
    appearance: none;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    padding: 9px 14px;
    width: 220px;
    max-width: 100%;
  }

  .search-input::placeholder {
    color: var(--muted);
  }

  .skill-count {
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .skill-group + .skill-group {
    margin-top: 48px;
  }

  .group-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }

  .skill-card {
    display: block;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 20px 22px;
    color: inherit;
    text-decoration: none;
    transition:
      background-color 0.2s var(--easing),
      border-color 0.2s var(--easing);
  }

  .skill-card:hover {
    background: var(--card);
    border-color: var(--line-strong);
  }

  a.skill-card.is-linked:hover .skill-name {
    text-decoration: underline;
  }

  .skill-card[hidden] {
    display: none;
  }

  .skill-name {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }

  .skill-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .no-results {
    margin-top: 32px;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .filter-bar {
      align-items: flex-start;
    }

    .search-wrap {
      width: 100%;
      justify-content: space-between;
    }

    .search-input {
      width: 100%;
    }
  }
</style>

<script>
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pill'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.skill-group'));
  const totalCards = document.querySelectorAll('.skill-card').length;
  const search = document.getElementById('skill-search') as HTMLInputElement | null;
  const countEl = document.getElementById('skill-count');
  const noResults = document.getElementById('no-results');
  const noResultsQuery = document.getElementById('no-results-query');

  let activeCategory = 'all';

  function applyFilter() {
    const q = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;

    groups.forEach((group) => {
      const category = group.dataset.category;
      const categoryMatch = activeCategory === 'all' || category === activeCategory;
      let groupVisible = 0;

      group.querySelectorAll<HTMLElement>('.skill-card').forEach((card) => {
        const text = card.dataset.search ?? '';
        const match = categoryMatch && (!q || text.includes(q));
        card.hidden = !match;
        if (match) {
          groupVisible += 1;
          visible += 1;
        }
      });

      group.hidden = groupVisible === 0;
    });

    if (countEl) countEl.textContent = `${visible} of ${totalCards}`;
    if (noResults) {
      noResults.hidden = visible !== 0;
      if (noResultsQuery) noResultsQuery.textContent = q;
    }
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeCategory = pill.dataset.category ?? 'all';
      pills.forEach((p) => p.setAttribute('aria-pressed', String(p === pill)));
      applyFilter();
    });
  });

  search?.addEventListener('input', applyFilter);
</script>
