---
import System from '../../layouts/System.astro';
import { getFeaturedSystems } from '../../lib/systems';
import { render } from 'astro:content';

export async function getStaticPaths() {
  // Personal projects link straight to their live homepage (with a hover preview)
  // instead of an internal case study page — only production work gets one here.
  const featured = (await getFeaturedSystems()).filter((entry) => entry.data.context === 'production');

  return featured.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? featured[i - 1] : null,
      next: i < featured.length - 1 ? featured[i + 1] : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<System system={entry} prev={prev} next={next} Content={Content} />
