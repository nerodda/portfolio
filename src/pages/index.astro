---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import RegistryGroup from '../components/RegistryGroup.astro';
import SystemCard from '../components/SystemCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getSystemsByContext, getFeaturedSystems } from '../lib/systems';

const production = await getSystemsByContext('production');
const independent = await getSystemsByContext('independent');
const featured = await getFeaturedSystems();
---

<Base
  title="Olga Neroda"
  description="AI systems for B2B revenue teams — production pipelines, case studies, and independent builds."
>
  <SiteHeader />

  <main>
    <div class="wrap hero">
      <div class="eyebrow">
        <span>AI Systems</span>
        <span>Marketing Technology</span>
      </div>
      <h1>I build AI systems for B2B revenue teams.</h1>
    </div>

    <section class="registry" aria-labelledby="registry-heading">
      <div class="wrap">
        <h2 id="registry-heading" class="visually-hidden">Systems</h2>
        <RegistryGroup label="RECENT PROJECTS" systems={production} startIndex={0} />
        <RegistryGroup label="PERSONAL PROJECTS" systems={independent} startIndex={production.length} />
      </div>
    </section>

    <section class="selected-work" aria-labelledby="selected-heading">
      <div class="wrap">
        <p id="selected-heading" class="eyebrow-label">Selected work</p>
        <div class="cards">
          {featured.map((system) => (
            <SystemCard system={system} />
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .eyebrow-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 32px;
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  @media (max-width: 720px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
